---
interface Props {
  sections: { key: string; label: string }[];
}
const { sections } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {sections.map((section) => (
    <a href={`#${section.key}`} class="rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent">{section.label}</a>
  ))}
</div>
