{
  "name": "ammo4life",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "workers_dev": false,
  // Serve the site on the real domain (DNS for ammo4life.com is on Cloudflare).
  "routes": [
    { "pattern": "ammo4life.com", "custom_domain": true },
    { "pattern": "www.ammo4life.com", "custom_domain": true }
  ]
  // Newsletter signups go to Supabase. Set SUPABASE_URL and SUPABASE_ANON_KEY with
  // `npx wrangler secret put <NAME>` (or in the Cloudflare dashboard > Settings > Variables).
}
